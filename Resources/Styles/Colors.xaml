<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ==================== MONOCHROME PALETTE ==================== -->

    <!-- Core neutrals -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Transparent">Transparent</Color>

    <!-- Gray scale -->
    <Color x:Key="Gray50">#FAFAFA</Color>
    <Color x:Key="Gray100">#F5F5F7</Color>
    <Color x:Key="Gray200">#E5E5EA</Color>
    <Color x:Key="Gray300">#D1D1D6</Color>
    <Color x:Key="Gray400">#AEAEB2</Color>
    <Color x:Key="Gray500">#8E8E93</Color>
    <Color x:Key="Gray600">#636366</Color>
    <Color x:Key="Gray700">#48484A</Color>
    <Color x:Key="Gray800">#3A3A3C</Color>
    <Color x:Key="Gray850">#2C2C2E</Color>
    <Color x:Key="Gray900">#1C1C1E</Color>
    <Color x:Key="Gray950">#0D0D0D</Color>

    <!-- Functional colors (used sparingly) -->
    <Color x:Key="Success">#34C759</Color>
    <Color x:Key="SuccessDark">#30D158</Color>
    <Color x:Key="Danger">#FF3B30</Color>
    <Color x:Key="DangerDark">#FF453A</Color>
    <Color x:Key="Gold">#FFD60A</Color>
    <Color x:Key="WarmupColor">#FF9500</Color>
    <Color x:Key="DropSetColor">#AF52DE</Color>
    <Color x:Key="FailureColor">#FF3B30</Color>

    <!-- Legacy aliases (for backward compatibility during migration) -->
    <Color x:Key="AccentBlue">#000000</Color>
    <Color x:Key="AccentBlueDark">#000000</Color>
    <Color x:Key="AccentBlueLight">#8E8E93</Color>
    <Color x:Key="AccentGold">#FFD60A</Color>
    <Color x:Key="AccentGoldLight">#FFD60A</Color>
    <Color x:Key="DangerRed">#FF3B30</Color>
    <Color x:Key="DangerRedDark">#FF453A</Color>
    <Color x:Key="SuccessGreen">#34C759</Color>
    <Color x:Key="SuccessGreenLight">#34C759</Color>
    <Color x:Key="SuccessGreenDark">#30D158</Color>

    <!-- Muscle group colors (muted, desaturated for monochrome aesthetic) -->
    <Color x:Key="MuscleChest">#8E8E93</Color>
    <Color x:Key="MuscleBack">#636366</Color>
    <Color x:Key="MuscleShoulders">#AEAEB2</Color>
    <Color x:Key="MuscleBiceps">#48484A</Color>
    <Color x:Key="MuscleTriceps">#8E8E93</Color>
    <Color x:Key="MuscleLegs">#636366</Color>
    <Color x:Key="MuscleCore">#AEAEB2</Color>
    <Color x:Key="MuscleCardio">#48484A</Color>

    <!-- ==================== THEMED COLORS ==================== -->

    <!-- Page backgrounds -->
    <Color x:Key="PageBackgroundLight">#FFFFFF</Color>
    <Color x:Key="PageBackgroundDark">#000000</Color>
    <Color x:Key="PageBackgroundSecondaryLight">#F5F5F7</Color>
    <Color x:Key="PageBackgroundSecondaryDark">#1C1C1E</Color>

    <!-- Card backgrounds -->
    <Color x:Key="CardBackgroundLight">#FFFFFF</Color>
    <Color x:Key="CardBackgroundDark">#1C1C1E</Color>
    <Color x:Key="CardBackgroundElevatedLight">#F5F5F7</Color>
    <Color x:Key="CardBackgroundElevatedDark">#2C2C2E</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryLight">#000000</Color>
    <Color x:Key="TextPrimaryDark">#FFFFFF</Color>
    <Color x:Key="TextSecondaryLight">#86868B</Color>
    <Color x:Key="TextSecondaryDark">#86868B</Color>
    <Color x:Key="TextTertiaryLight">#AEAEB2</Color>
    <Color x:Key="TextTertiaryDark">#636366</Color>

    <!-- UI Elements -->
    <Color x:Key="SeparatorLight">#E5E5EA</Color>
    <Color x:Key="SeparatorDark">#38383A</Color>
    <Color x:Key="InputBackgroundLight">#F5F5F7</Color>
    <Color x:Key="InputBackgroundDark">#1C1C1E</Color>
    <Color x:Key="SetCompletedBackgroundLight">#F0F0F0</Color>
    <Color x:Key="SetCompletedBackgroundDark">#2C2C2E</Color>

    <!-- Primary fill (black in light, white in dark — like macOS buttons) -->
    <Color x:Key="FillPrimaryLight">#000000</Color>
    <Color x:Key="FillPrimaryDark">#FFFFFF</Color>
    <Color x:Key="FillOnPrimaryLight">#FFFFFF</Color>
    <Color x:Key="FillOnPrimaryDark">#000000</Color>
    <Color x:Key="FillSecondaryLight">#F5F5F7</Color>
    <Color x:Key="FillSecondaryDark">#2C2C2E</Color>

    <!-- Tab Bar -->
    <Color x:Key="TabBarBackgroundLight">#FAFAFA</Color>
    <Color x:Key="TabBarBackgroundDark">#000000</Color>
    <Color x:Key="TabBarIconActiveLight">#000000</Color>
    <Color x:Key="TabBarIconActiveDark">#FFFFFF</Color>
    <Color x:Key="TabBarIconInactiveLight">#AEAEB2</Color>
    <Color x:Key="TabBarIconInactiveDark">#636366</Color>

    <!-- Overlay -->
    <Color x:Key="OverlayBackgroundLight">#40000000</Color>
    <Color x:Key="OverlayBackgroundDark">#80000000</Color>

    <!-- ==================== BRUSHES ==================== -->
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="AccentGoldBrush" Color="{StaticResource Gold}"/>
    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

</ResourceDictionary>
