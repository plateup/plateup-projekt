<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PlateUp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PlateUp.Views"
    xmlns:helpers="clr-namespace:PlateUp.Helpers"
    Title="PlateUp"
    FlyoutBehavior="Disabled">

    <TabBar>
        <Tab Title="Feed">
            <Tab.Icon>
                <FontImageSource FontFamily="FASolid"
                                 Glyph="{x:Static helpers:Icons.Fire}"
                                 Size="24" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:FeedPage}" Route="feed" />
        </Tab>

        <Tab Title="Workout">
            <Tab.Icon>
                <FontImageSource FontFamily="FASolid"
                                 Glyph="{x:Static helpers:Icons.Dumbbell}"
                                 Size="24" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:WorkoutHubPage}" Route="workout" />
        </Tab>

        <Tab Title="Coach">
            <Tab.Icon>
                <FontImageSource FontFamily="FASolid"
                                 Glyph="{x:Static helpers:Icons.Bolt}"
                                 Size="24" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:CoachPage}" Route="coach" />
        </Tab>

        <Tab Title="Profile">
            <Tab.Icon>
                <FontImageSource FontFamily="FASolid"
                                 Glyph="{x:Static helpers:Icons.User}"
                                 Size="24" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" Route="profile" />
        </Tab>
    </TabBar>

</Shell>
