<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PlateUp.ViewModels"
             xmlns:wvm="clr-namespace:PlateUp.ViewModels.WorkoutViewModels"
             xmlns:helpers="clr-namespace:PlateUp.Helpers"
             xmlns:controls="clr-namespace:PlateUp.Controls"
             x:Class="PlateUp.Views.LiveWorkoutPage"
             x:DataType="vm:LiveWorkoutViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- DRAG HANDLE -->
        <VerticalStackLayout Grid.Row="0" Padding="0,10,0,0" HorizontalOptions="Center">
            <Border WidthRequest="40" HeightRequest="5"
                    StrokeShape="RoundRectangle 2.5"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                    HorizontalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding MinimizeWorkoutCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </VerticalStackLayout>

        <!-- HEADER -->
        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*,Auto"
              Padding="20,8,20,8"
              ColumnSpacing="12">

            <Button Grid.Column="0"
                    Text="{x:Static helpers:Icons.ChevronLeft}"
                    Style="{StaticResource IconButton}"
                    Command="{Binding MinimizeWorkoutCommand}" />

            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                <Entry Text="{Binding WorkoutTitle}"
                       BackgroundColor="Transparent"
                       HorizontalTextAlignment="Center"
                       FontAttributes="Bold"
                       FontSize="17" />
                <Label Text="{Binding ElapsedTimeText}"
                       Style="{StaticResource SmallCaption}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Button Grid.Column="2"
                    Text="Finish"
                    Style="{StaticResource TextButton}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                    FontAttributes="Bold"
                    FontSize="16"
                    Command="{Binding FinishWorkoutCommand}" />
        </Grid>

        <!-- LOADING -->
        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- BODY -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="0"
                                 Padding="0,0,0,16">

                <!-- Empty State -->
                <controls:EmptyStateView IconGlyph="{x:Static helpers:Icons.Dumbbell}"
                                         Title="No exercises yet"
                                         Subtitle="Add an exercise to start your workout"
                                         IsVisible="False">
                    <controls:EmptyStateView.Triggers>
                        <DataTrigger TargetType="controls:EmptyStateView"
                                     Binding="{Binding Exercises.Count}"
                                     Value="0">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </controls:EmptyStateView.Triggers>
                </controls:EmptyStateView>

                <!-- Exercises -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="wvm:ExerciseGroupViewModel">
                            <Border Style="{StaticResource GroupedSection}" Margin="20,8" Padding="16,16,16,8">
                                <VerticalStackLayout Spacing="8">

                                    <!-- Superset indicator -->
                                    <Border StrokeShape="RoundRectangle 8"
                                            StrokeThickness="0"
                                            Padding="8,4"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                            HorizontalOptions="Start"
                                            IsVisible="{Binding IsInSuperset}">
                                        <Label Text="SUPERSET"
                                               FontSize="10" FontAttributes="Bold"
                                               CharacterSpacing="1"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                    </Border>

                                    <!-- Exercise Header -->
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                        <Label Text="{Binding ExerciseName}"
                                               Style="{StaticResource HeadlineSmall}"
                                               FontSize="18"
                                               VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LiveWorkoutViewModel}}, Path=ViewExerciseDetailCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Button Grid.Column="1"
                                                Text="{x:Static helpers:Icons.Ellipsis}"
                                                Style="{StaticResource IconButton}"
                                                HeightRequest="36"
                                                WidthRequest="36"
                                                FontSize="14"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LiveWorkoutViewModel}}, Path=ShowExerciseOptionsCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>

                                    <!-- Notes -->
                                    <Border Style="{StaticResource GroupedSection}" Padding="4,0"
                                            IsVisible="{Binding ShowNotes}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}">
                                        <Entry Text="{Binding Notes}"
                                               Placeholder="Add a note..."
                                               BackgroundColor="Transparent"
                                               FontSize="15"
                                               MinimumHeightRequest="44" />
                                    </Border>

                                    <!-- Table Headers -->
                                    <Grid ColumnDefinitions="0.7*,1.4*,1.3*,1.3*,0.7*"
                                          Padding="0,6,0,2">
                                        <Label Grid.Column="0" Text="SET"
                                               Style="{StaticResource SmallCaption}"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="1" Text="PREVIOUS"
                                               Style="{StaticResource SmallCaption}"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="2" Text="KG"
                                               Style="{StaticResource SmallCaption}"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="3" Text="REPS"
                                               Style="{StaticResource SmallCaption}"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="4"
                                               Text="{x:Static helpers:Icons.Check}"
                                               FontFamily="FASolid"
                                               FontSize="11"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
                                    </Grid>

                                    <!-- Set Rows -->
                                    <VerticalStackLayout Spacing="0"
                                                         BindableLayout.ItemsSource="{Binding Sets}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="wvm:SetRowViewModel">
                                                <SwipeView>
                                                    <SwipeView.LeftItems>
                                                        <SwipeItems>
                                                            <SwipeItem Text="Delete"
                                                                       BackgroundColor="{StaticResource Danger}"
                                                                       Command="{Binding Source={RelativeSource AncestorType={x:Type wvm:ExerciseGroupViewModel}}, Path=RemoveSetCommand}"
                                                                       CommandParameter="{Binding .}" />
                                                        </SwipeItems>
                                                    </SwipeView.LeftItems>

                                                    <Border StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 10"
                                                            Padding="0,2"
                                                            Margin="0,2"
                                                            BackgroundColor="Transparent">
                                                        <Border.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SetCompletedBackgroundLight}, Dark={StaticResource SetCompletedBackgroundDark}}" />
                                                            </DataTrigger>
                                                        </Border.Triggers>

                                                        <Grid ColumnDefinitions="0.7*,1.4*,1.3*,1.3*,0.7*"
                                                              MinimumHeightRequest="52"
                                                              Padding="0,2">

                                                            <!-- Set Number -->
                                                            <Label Grid.Column="0"
                                                                   Text="{Binding SetLabel}"
                                                                   HorizontalTextAlignment="Center"
                                                                   VerticalTextAlignment="Center"
                                                                   FontAttributes="Bold"
                                                                   FontSize="16"
                                                                   TextColor="{Binding SetType, Converter={StaticResource SetTypeToColorConverter}}">
                                                                <Label.GestureRecognizers>
                                                                    <TapGestureRecognizer Command="{Binding CycleSetTypeCommand}" />
                                                                </Label.GestureRecognizers>
                                                            </Label>

                                                            <!-- Previous -->
                                                            <Label Grid.Column="1"
                                                                   Text="{Binding PreviousResult}"
                                                                   HorizontalTextAlignment="Center"
                                                                   VerticalTextAlignment="Center"
                                                                   FontSize="13"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}">
                                                                <Label.GestureRecognizers>
                                                                    <TapGestureRecognizer Command="{Binding CopyPreviousCommand}" />
                                                                </Label.GestureRecognizers>
                                                            </Label>

                                                            <!-- Weight -->
                                                            <Border Grid.Column="2"
                                                                    StrokeThickness="0"
                                                                    StrokeShape="RoundRectangle 8"
                                                                    Padding="2,0"
                                                                    Margin="4,4"
                                                                    BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}">
                                                                <Entry Text="{Binding WeightText}"
                                                                       Placeholder="{Binding PreviousWeight, StringFormat='{0:0.##}'}"
                                                                       BackgroundColor="Transparent"
                                                                       Keyboard="Numeric"
                                                                       FontSize="16"
                                                                       FontAttributes="Bold"
                                                                       HorizontalTextAlignment="Center"
                                                                       MinimumHeightRequest="40"
                                                                       ReturnType="Next"
                                                                       Completed="OnWeightCompleted" />
                                                            </Border>

                                                            <!-- Reps -->
                                                            <Border Grid.Column="3"
                                                                    StrokeThickness="0"
                                                                    StrokeShape="RoundRectangle 8"
                                                                    Padding="2,0"
                                                                    Margin="4,4"
                                                                    BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}">
                                                                <Entry Text="{Binding RepsText}"
                                                                       Placeholder="{Binding PreviousReps, StringFormat='{0}'}"
                                                                       BackgroundColor="Transparent"
                                                                       Keyboard="Numeric"
                                                                       FontSize="16"
                                                                       FontAttributes="Bold"
                                                                       HorizontalTextAlignment="Center"
                                                                       MinimumHeightRequest="40"
                                                                       ReturnType="Done"
                                                                       Completed="OnRepsCompleted" />
                                                            </Border>

                                                            <!-- Checkbox - styled circle -->
                                                            <Border Grid.Column="4"
                                                                    WidthRequest="34"
                                                                    HeightRequest="34"
                                                                    HorizontalOptions="Center"
                                                                    VerticalOptions="Center"
                                                                    StrokeShape="RoundRectangle 17"
                                                                    StrokeThickness="2"
                                                                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                                                                    BackgroundColor="Transparent">
                                                                <Border.Triggers>
                                                                    <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                                                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                                                    </DataTrigger>
                                                                </Border.Triggers>
                                                                <Label Text="{x:Static helpers:Icons.Check}"
                                                                       FontFamily="FASolid"
                                                                       FontSize="14"
                                                                       HorizontalOptions="Center"
                                                                       VerticalOptions="Center"
                                                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                                                                       IsVisible="{Binding IsCompleted}" />
                                                                <Border.GestureRecognizers>
                                                                    <TapGestureRecognizer
                                                                        Tapped="OnCheckTapped" />
                                                                </Border.GestureRecognizers>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </SwipeView>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <!-- Add Set / Drop Set -->
                                    <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                        <Button Text="+ Add Set"
                                                Style="{StaticResource TextButton}"
                                                HorizontalOptions="Start"
                                                FontSize="15"
                                                Command="{Binding AddSetCommand}" />
                                        <Button Text="+ Drop Set"
                                                Style="{StaticResource TextButton}"
                                                HorizontalOptions="Start"
                                                FontSize="15"
                                                TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                                Command="{Binding AddDropSetCommand}" />
                                    </HorizontalStackLayout>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- MINI REST TIMER BAR -->
        <Border Grid.Row="3"
                IsVisible="{Binding IsRestTimerRunning}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0"
                Padding="16,12"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ShowRestTimerOverlayCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Label Grid.Column="0"
                       Text="{x:Static helpers:Icons.Stopwatch}"
                       FontFamily="FASolid"
                       FontSize="16"
                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="{Binding RestTimerText}"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                       VerticalOptions="Center" />
                <Border Grid.Column="2"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        WidthRequest="28" HeightRequest="28"
                        BackgroundColor="Transparent">
                    <Label Text="{x:Static helpers:Icons.Times}"
                           FontFamily="FASolid"
                           FontSize="13"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SkipRestTimerCommand}" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <VerticalStackLayout Grid.Row="4"
                             Padding="20,12,20,20"
                             Spacing="8"
                             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
            <Button Text="+ Add Exercise"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddExerciseCommand}" />
            <Button Text="Cancel Workout"
                    Style="{StaticResource DangerButton}"
                    FontSize="14"
                    Command="{Binding CancelWorkoutCommand}" />
        </VerticalStackLayout>

        <!-- REST TIMER OVERLAY - Full screen, clean -->
        <Border Grid.RowSpan="5"
                IsVisible="{Binding IsRestTimerVisible}"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

            <Grid RowDefinitions="Auto,*,Auto" Padding="24">
                <!-- Close button -->
                <Button Grid.Row="0"
                        Text="{x:Static helpers:Icons.Times}"
                        Style="{StaticResource IconButton}"
                        HorizontalOptions="End"
                        Command="{Binding HideRestTimerOverlayCommand}" />

                <!-- Timer display -->
                <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="24" HorizontalOptions="Center">
                    <Label Text="Rest"
                           Style="{StaticResource Caption}"
                           HorizontalTextAlignment="Center"
                           FontSize="15" />

                    <!-- Circular Timer -->
                    <GraphicsView x:Name="TimerGraphicsView"
                                  HeightRequest="220"
                                  WidthRequest="220"
                                  HorizontalOptions="Center" />

                    <!-- Preset buttons -->
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border StrokeShape="RoundRectangle 22" StrokeThickness="0"
                                WidthRequest="60" HeightRequest="44"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray850}}">
                            <Label Text="60s" FontSize="15" FontAttributes="Bold"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetRestTimerPresetCommand}" CommandParameter="60" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border StrokeShape="RoundRectangle 22" StrokeThickness="0"
                                WidthRequest="60" HeightRequest="44"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray850}}">
                            <Label Text="90s" FontSize="15" FontAttributes="Bold"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetRestTimerPresetCommand}" CommandParameter="90" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border StrokeShape="RoundRectangle 22" StrokeThickness="0"
                                WidthRequest="60" HeightRequest="44"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray850}}">
                            <Label Text="2m" FontSize="15" FontAttributes="Bold"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetRestTimerPresetCommand}" CommandParameter="120" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border StrokeShape="RoundRectangle 22" StrokeThickness="0"
                                WidthRequest="60" HeightRequest="44"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray850}}">
                            <Label Text="3m" FontSize="15" FontAttributes="Bold"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetRestTimerPresetCommand}" CommandParameter="180" />
                            </Border.GestureRecognizers>
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Bottom actions -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="12" Margin="0,0,0,20">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 14" StrokeThickness="0"
                            HeightRequest="48"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray850}}">
                        <Label Text="-15s" FontSize="16" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AdjustRestTimerCommand}" CommandParameter="-15" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 14" StrokeThickness="0"
                            HeightRequest="48"
                            BackgroundColor="{AppThemeBinding Light={StaticResource FillPrimaryLight}, Dark={StaticResource FillPrimaryDark}}">
                        <Label Text="Skip" FontSize="16" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SkipRestTimerCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Column="2" StrokeShape="RoundRectangle 14" StrokeThickness="0"
                            HeightRequest="48"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray850}}">
                        <Label Text="+15s" FontSize="16" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AdjustRestTimerCommand}" CommandParameter="15" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </Grid>
        </Border>

    </Grid>

</ContentPage>
