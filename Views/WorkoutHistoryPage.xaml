<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PlateUp.ViewModels"
             xmlns:dm="clr-namespace:PlateUp.ViewModels.DisplayModels"
             xmlns:helpers="clr-namespace:PlateUp.Helpers"
             x:Class="PlateUp.Views.WorkoutHistoryPage"
             x:DataType="vm:WorkoutHistoryViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              Padding="20,12">
            <Button Grid.Column="0"
                    Text="{x:Static helpers:Icons.ChevronLeft}"
                    Style="{StaticResource IconButton}"
                    Command="{Binding GoBackCommand}" />
            <Label Grid.Column="1"
                   Text="Workout History"
                   Style="{StaticResource Title}"
                   VerticalOptions="Center"
                   Margin="8,0,0,0" />
        </Grid>

        <!-- Loading -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- Grouped List -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding InitializeAsyncCommand}">
        <CollectionView ItemsSource="{Binding GroupedWorkouts}"
                        IsGrouped="True">

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="dm:WorkoutHistoryGroup">
                    <Label Text="{Binding MonthYear}"
                           Style="{StaticResource SubTitle}"
                           Margin="20,16,20,4" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dm:WorkoutHistoryItem">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete"
                                           BackgroundColor="{StaticResource DangerRed}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutHistoryViewModel}}, Path=DeleteWorkoutCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Style="{StaticResource Card}" Margin="20,4">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutHistoryViewModel}}, Path=ViewWorkoutCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="12" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <Label Text="{Binding Date, StringFormat='{0:dd}'}"
                                           Style="{StaticResource Body}"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding Date, StringFormat='{0:MMM}'}"
                                           Style="{StaticResource Caption}"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>

                                <Label Grid.Column="1"
                                       Text="{Binding Title}"
                                       Style="{StaticResource Body}"
                                       VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding DurationFormatted}"
                                           Style="{StaticResource Caption}"
                                           HorizontalTextAlignment="End"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label Text="{Binding VolumeFormatted}"
                                           Style="{StaticResource Caption}"
                                           HorizontalTextAlignment="End"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label Text="{Binding SetCount, StringFormat='{0} sets'}"
                                           Style="{StaticResource Caption}"
                                           HorizontalTextAlignment="End"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Padding="32">
                    <Label Text="{x:Static helpers:Icons.Dumbbell}"
                           FontFamily="FASolid"
                           FontSize="48"
                           HorizontalOptions="Center"
                           Opacity="0.2"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="No workouts yet"
                           Style="{StaticResource HeadlineSmall}"
                           HorizontalOptions="Center"
                           Margin="0,8,0,0" />
                    <Label Text="Complete a workout to see it here"
                           Style="{StaticResource Caption}"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

        </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
