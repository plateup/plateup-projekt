<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PlateUp.ViewModels"
             xmlns:dm="clr-namespace:PlateUp.ViewModels.DisplayModels"
             xmlns:helpers="clr-namespace:PlateUp.Helpers"
             x:Class="PlateUp.Views.RoutineEditorPage"
             x:DataType="vm:RoutineEditorViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ═══ HEADER ═══ -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              Padding="20,12">
            <Button Grid.Column="0"
                    Text="Cancel"
                    Style="{StaticResource TextButton}"
                    Command="{Binding CancelCommand}" />
            <Label Grid.Column="1"
                   Text="{Binding PageTitle}"
                   Style="{StaticResource Title}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
            <Button Grid.Column="2"
                    Text="Save"
                    Style="{StaticResource TextButton}"
                    TextColor="{StaticResource AccentBlue}"
                    FontAttributes="Bold"
                    Command="{Binding SaveRoutineCommand}" />
        </Grid>

        <!-- ═══ BODY ═══ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,16">

                <!-- Routine Name -->
                <Border Style="{StaticResource GroupedSection}" Margin="20,0,20,8" Padding="4,0">
                    <Entry Text="{Binding RoutineName}"
                           Style="{StaticResource InputEntry}"
                           Placeholder="Routine name"
                           FontSize="22"
                           FontAttributes="Bold"
                           BackgroundColor="Transparent" />
                </Border>

                <!-- Exercises -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dm:RoutineExerciseDisplay">
                            <Border Style="{StaticResource Card}" Margin="20,8">
                                <VerticalStackLayout Spacing="8">

                                    <!-- Exercise Header -->
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                                        <Label Text="{Binding ExerciseName}"
                                               Style="{StaticResource AccentLabel}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                        <Button Grid.Column="1"
                                                Text="{x:Static helpers:Icons.ChevronLeft}"
                                                Style="{StaticResource IconButton}"
                                                HeightRequest="32" WidthRequest="32"
                                                FontSize="12"
                                                Rotation="90"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RoutineEditorViewModel}}, Path=MoveExerciseUpCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="2"
                                                Text="{x:Static helpers:Icons.ChevronRight}"
                                                Style="{StaticResource IconButton}"
                                                HeightRequest="32" WidthRequest="32"
                                                FontSize="12"
                                                Rotation="90"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RoutineEditorViewModel}}, Path=MoveExerciseDownCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="3"
                                                Text="{x:Static helpers:Icons.Times}"
                                                Style="{StaticResource IconButton}"
                                                HeightRequest="32" WidthRequest="32"
                                                FontSize="12"
                                                TextColor="{StaticResource DangerRed}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RoutineEditorViewModel}}, Path=RemoveExerciseCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>

                                    <!-- Table Headers -->
                                    <Grid ColumnDefinitions="0.8*,1.2*,1.2*" Padding="0,4">
                                        <Label Grid.Column="0" Text="SET" Style="{StaticResource SmallCaption}" HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="1" Text="KG" Style="{StaticResource SmallCaption}" HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="2" Text="REPS" Style="{StaticResource SmallCaption}" HorizontalTextAlignment="Center" />
                                    </Grid>

                                    <!-- Set Rows -->
                                    <VerticalStackLayout Spacing="2"
                                                         BindableLayout.ItemsSource="{Binding Sets}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="dm:RoutineSetDisplay">
                                                <SwipeView>
                                                    <SwipeView.RightItems>
                                                        <SwipeItems>
                                                            <SwipeItem Text="Delete"
                                                                       BackgroundColor="{StaticResource DangerRed}"
                                                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RoutineEditorViewModel}}, Path=RemoveSetCommand}"
                                                                       CommandParameter="{Binding .}" />
                                                        </SwipeItems>
                                                    </SwipeView.RightItems>
                                                    <Grid ColumnDefinitions="0.8*,1.2*,1.2*"
                                                          MinimumHeightRequest="40"
                                                          Padding="0,2">
                                                        <Label Grid.Column="0"
                                                               Text="{Binding OrderIndex}"
                                                               Style="{StaticResource SetNumber}"
                                                               VerticalTextAlignment="Center" />
                                                        <Entry Grid.Column="1"
                                                               Text="{Binding WeightText}"
                                                               Style="{StaticResource NumericEntry}"
                                                               Placeholder="0"
                                                               FontSize="14" />
                                                        <Entry Grid.Column="2"
                                                               Text="{Binding RepsText}"
                                                               Style="{StaticResource NumericEntry}"
                                                               Placeholder="0"
                                                               FontSize="14" />
                                                    </Grid>
                                                </SwipeView>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <!-- Add Set -->
                                    <Button Text="+ Add Set"
                                            Style="{StaticResource TextButton}"
                                            HorizontalOptions="Start"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RoutineEditorViewModel}}, Path=AddSetCommand}"
                                            CommandParameter="{Binding .}" />

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══ FOOTER ═══ -->
        <VerticalStackLayout Grid.Row="2" Padding="20,16">
            <Button Text="+ Add Exercise"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding AddExercisesCommand}" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
