<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PlateUp.ViewModels"
             xmlns:dm="clr-namespace:PlateUp.ViewModels.DisplayModels"
             xmlns:helpers="clr-namespace:PlateUp.Helpers"
             xmlns:controls="clr-namespace:PlateUp.Controls"
             x:Class="PlateUp.Views.FeedPage"
             x:DataType="vm:FeedViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="*,Auto">
    <RefreshView Grid.Row="0" IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshFeedCommand}">
        <CollectionView ItemsSource="{Binding Posts}"
                        ItemSizingStrategy="MeasureAllItems"
                        SelectionMode="None">

            <CollectionView.Header>
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" Padding="20,16,20,12">
                        <Label Text="Feed"
                               Style="{StaticResource LargeTitle}" />
                        <Button Grid.Column="1"
                                Text="{x:Static helpers:Icons.Search}"
                                Style="{StaticResource IconButton}"
                                Command="{Binding SearchUsersCommand}" />
                    </Grid>

                    <!-- Offline banner -->
                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0"
                            Margin="20,0,20,8" Padding="12,10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray850}}"
                            IsVisible="{Binding IsOffline}">
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="{x:Static helpers:Icons.Globe}"
                                   FontFamily="FASolid" FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                   VerticalOptions="Center" />
                            <Label Text="You're offline — showing local workouts"
                                   Style="{StaticResource Caption}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Cloud login prompt -->
                    <Border Style="{StaticResource GroupedSection}" Margin="20,0,20,8"
                            Padding="16"
                            IsVisible="{Binding IsLoggedIn, Converter={StaticResource InverseBoolConverter}}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="40" HeightRequest="40"
                                    StrokeShape="RoundRectangle 20"
                                    StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                <Label Text="{x:Static helpers:Icons.Globe}"
                                       FontFamily="FASolid" FontSize="16"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Connect with others"
                                       Style="{StaticResource HeadlineSmall}" />
                                <Label Text="Log in to see community workouts"
                                       Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="Log In"
                                    Style="{StaticResource SecondaryButton}"
                                    HeightRequest="36" Padding="16,0" FontSize="14"
                                    CornerRadius="18"
                                    VerticalOptions="Center"
                                    Command="{Binding GoToAuthCommand}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="12"
                                     Padding="32,60"
                                     HorizontalOptions="Center">
                    <Label Text="{x:Static helpers:Icons.Users}"
                           FontFamily="FASolid"
                           FontSize="56"
                           HorizontalOptions="Center"
                           Opacity="0.15"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="Connect with friends"
                           Style="{StaticResource HeadlineSmall}"
                           HorizontalOptions="Center" />
                    <Label Text="Sign up to see your friends' workouts"
                           Style="{StaticResource Caption}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                    <Button Text="Sign Up"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,8,0,0"
                            HorizontalOptions="Center"
                            Padding="32,0"
                            Command="{Binding GoToAuthCommand}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dm:WorkoutPostDisplay">
                    <Border Style="{StaticResource Card}" Margin="20,6">
                        <VerticalStackLayout Spacing="14">

                            <!-- User Header -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border WidthRequest="40" HeightRequest="40"
                                        StrokeShape="RoundRectangle 20"
                                        StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}">
                                    <Label Text="{Binding UserAvatarLetter}"
                                           TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                                           FontSize="16" FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FeedViewModel}}, Path=ViewUserProfileCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding UserNickname}"
                                           Style="{StaticResource HeadlineSmall}" />
                                    <Label Text="{Binding StartTime, Converter={StaticResource RelativeTimeConverter}}"
                                           Style="{StaticResource SmallCaption}" />
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FeedViewModel}}, Path=ViewUserProfileCommand}"
                                            CommandParameter="{Binding .}" />
                                    </VerticalStackLayout.GestureRecognizers>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Title -->
                            <Label Text="{Binding Title}"
                                   Style="{StaticResource Title}" />

                            <!-- Stat Pills -->
                            <HorizontalStackLayout Spacing="8">
                                <!-- Duration -->
                                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,6"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray850}}">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{x:Static helpers:Icons.Clock}"
                                               FontFamily="FASolid" FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding Duration}"
                                               Style="{StaticResource Caption}" FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                </Border>
                                <!-- Volume -->
                                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,6"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray850}}">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{x:Static helpers:Icons.Weight}"
                                               FontFamily="FASolid" FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding Volume}"
                                               Style="{StaticResource Caption}" FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                </Border>
                                <!-- Sets -->
                                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,6"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray850}}">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{x:Static helpers:Icons.CircleCheck}"
                                               FontFamily="FASolid" FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding SetCount, StringFormat='{0} sets'}"
                                               Style="{StaticResource Caption}" FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                </Border>
                                <!-- PRs (if any) -->
                                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,6"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray850}}"
                                        IsVisible="{Binding HasPRs}">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{x:Static helpers:Icons.Trophy}"
                                               FontFamily="FASolid" FontSize="11"
                                               TextColor="{StaticResource Gold}"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding PrCount, StringFormat='{0} PRs'}"
                                               Style="{StaticResource Caption}" FontAttributes="Bold"
                                               TextColor="{StaticResource Gold}" />
                                    </HorizontalStackLayout>
                                </Border>
                            </HorizontalStackLayout>

                            <!-- Exercises -->
                            <VerticalStackLayout Spacing="8"
                                                 BindableLayout.ItemsSource="{Binding Exercises}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dm:FeedExerciseDisplay">
                                        <Grid ColumnDefinitions="40,*" ColumnSpacing="12">
                                            <Border WidthRequest="36" HeightRequest="36"
                                                    StrokeShape="RoundRectangle 10"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray850}}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding AvatarLetter}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="{Binding ExerciseName}"
                                                           Style="{StaticResource Body}" />
                                                    <Label Text="{x:Static helpers:Icons.Trophy}"
                                                           FontFamily="FASolid" FontSize="11"
                                                           TextColor="{StaticResource Gold}"
                                                           VerticalOptions="Center"
                                                           IsVisible="{Binding HasPR}" />
                                                </HorizontalStackLayout>
                                                <Label Style="{StaticResource Caption}">
                                                    <Label.Text>
                                                        <MultiBinding StringFormat="{}{0} sets · Best: {1}">
                                                            <Binding Path="SetsCount" />
                                                            <Binding Path="BestSet" />
                                                        </MultiBinding>
                                                    </Label.Text>
                                                </Label>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Footer -->
                            <BoxView HeightRequest="0.5"
                                    Color="{AppThemeBinding Light={StaticResource SeparatorLight}, Dark={StaticResource SeparatorDark}}" />
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <HorizontalStackLayout Spacing="4">
                                    <Button Text="{x:Static helpers:Icons.Heart}"
                                            Style="{StaticResource IconButton}"
                                            HeightRequest="36" WidthRequest="36"
                                            FontSize="15"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FeedViewModel}}, Path=ToggleLikeCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Label Text="{Binding LikeCount}"
                                           Style="{StaticResource Caption}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Button Grid.Column="2"
                                        Text="Save Routine"
                                        Style="{StaticResource TextButton}"
                                        FontSize="13"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FeedViewModel}}, Path=SaveAsRoutineCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FeedViewModel}}, Path=ViewWorkoutDetailCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <Button Text="Load More"
                        Style="{StaticResource SecondaryButton}"
                        Margin="20,8"
                        IsVisible="{Binding HasMore}"
                        Command="{Binding LoadMoreCommand}" />
            </CollectionView.Footer>

        </CollectionView>
    </RefreshView>
    <controls:MiniWorkoutBar Grid.Row="1" />
    </Grid>

</ContentPage>
