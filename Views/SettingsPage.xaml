<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PlateUp.ViewModels"
             xmlns:helpers="clr-namespace:PlateUp.Helpers"
             x:Class="PlateUp.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundSecondaryLight}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="20,12">
            <Button Grid.Column="0"
                    Text="{x:Static helpers:Icons.ChevronLeft}"
                    Style="{StaticResource IconButton}"
                    Command="{Binding SaveCommand}" />
            <Label Grid.Column="1"
                   Text="Settings"
                   Style="{StaticResource HeadlineSmall}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,40">

                <!-- Avatar + Name -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,8,0,16">
                    <Border WidthRequest="72" HeightRequest="72"
                            StrokeShape="RoundRectangle 36"
                            StrokeThickness="0"
                            BackgroundColor="{Binding AvatarColor}"
                            HorizontalOptions="Center">
                        <Label Text="{Binding AvatarLetter}"
                               FontSize="28" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="{Binding Nickname}"
                           Style="{StaticResource HeadlineSmall}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Profile Section -->
                <Label Text="PROFILE"
                       Style="{StaticResource SmallCaption}"
                       FontAttributes="Bold"
                       Margin="20,8,20,8"
                       CharacterSpacing="1" />

                <Border Style="{StaticResource GroupedSection}" Margin="20,0" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,Auto,*" Padding="16,12" ColumnSpacing="12">
                            <Label Text="{x:Static helpers:Icons.User}"
                                   FontFamily="FASolid" FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Nickname"
                                   Style="{StaticResource Body}"
                                   VerticalOptions="Center" />
                            <Entry Grid.Column="2"
                                   Text="{Binding Nickname}"
                                   Style="{StaticResource InputEntry}"
                                   BackgroundColor="Transparent"
                                   HorizontalTextAlignment="End"
                                   Placeholder="Your name" />
                        </Grid>
                        <BoxView HeightRequest="0.5" Margin="52,0,0,0"
                                 Color="{AppThemeBinding Light={StaticResource SeparatorLight}, Dark={StaticResource SeparatorDark}}" />
                        <Grid ColumnDefinitions="Auto,Auto,*" Padding="16,12" ColumnSpacing="12">
                            <Label Text="{x:Static helpers:Icons.Edit}"
                                   FontFamily="FASolid" FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Bio"
                                   Style="{StaticResource Body}"
                                   VerticalOptions="Center" />
                            <Entry Grid.Column="2"
                                   Text="{Binding Bio}"
                                   Style="{StaticResource InputEntry}"
                                   BackgroundColor="Transparent"
                                   HorizontalTextAlignment="End"
                                   Placeholder="About you" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Appearance -->
                <Label Text="APPEARANCE"
                       Style="{StaticResource SmallCaption}"
                       FontAttributes="Bold"
                       Margin="20,24,20,8"
                       CharacterSpacing="1" />

                <Border Style="{StaticResource GroupedSection}" Margin="20,0" Padding="0">
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,12" ColumnSpacing="12">
                        <Label Text="{x:Static helpers:Icons.Moon}"
                               FontFamily="FASolid" FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Theme"
                               Style="{StaticResource Body}"
                               VerticalOptions="Center" />
                        <Picker Grid.Column="2"
                                ItemsSource="{Binding ThemeOptions}"
                                SelectedIndex="{Binding SelectedThemeIndex}"
                                WidthRequest="120" />
                    </Grid>
                </Border>

                <!-- Workout -->
                <Label Text="WORKOUT"
                       Style="{StaticResource SmallCaption}"
                       FontAttributes="Bold"
                       Margin="20,24,20,8"
                       CharacterSpacing="1" />

                <Border Style="{StaticResource GroupedSection}" Margin="20,0" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,*" Padding="16,12" ColumnSpacing="12">
                            <Label Text="{x:Static helpers:Icons.Stopwatch}"
                                   FontFamily="FASolid" FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Rest Timer"
                                       Style="{StaticResource Body}" />
                                <Label Style="{StaticResource Caption}">
                                    <Label.Text>
                                        <Binding Path="RestTimerSeconds" StringFormat="Default: {0}s" />
                                    </Label.Text>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>
                        <Slider Minimum="15" Maximum="300"
                                Value="{Binding RestTimerSeconds}"
                                Margin="52,0,16,12" />

                        <BoxView HeightRequest="0.5" Margin="52,0,0,0"
                                 Color="{AppThemeBinding Light={StaticResource SeparatorLight}, Dark={StaticResource SeparatorDark}}" />

                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14" ColumnSpacing="12">
                            <Label Text="{x:Static helpers:Icons.Weight}"
                                   FontFamily="FASolid" FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Use Kilograms (kg)"
                                   Style="{StaticResource Body}"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="2"
                                    IsToggled="{Binding UseKg}" />
                        </Grid>
                        <BoxView HeightRequest="0.5" Margin="52,0,0,0"
                                 Color="{AppThemeBinding Light={StaticResource SeparatorLight}, Dark={StaticResource SeparatorDark}}" />

                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14" ColumnSpacing="12">
                            <Label Text="{x:Static helpers:Icons.Clock}"
                                   FontFamily="FASolid" FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Auto-start rest timer"
                                   Style="{StaticResource Body}"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="2"
                                    IsToggled="{Binding AutoStartRestTimer}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Account -->
                <Label Text="ACCOUNT"
                       Style="{StaticResource SmallCaption}"
                       FontAttributes="Bold"
                       Margin="20,24,20,8"
                       CharacterSpacing="1" />

                <Border Style="{StaticResource GroupedSection}" Margin="20,0" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14" ColumnSpacing="12">
                            <Label Text="{x:Static helpers:Icons.Globe}"
                                   FontFamily="FASolid" FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Cloud Sync"
                                       Style="{StaticResource Body}" />
                                <Label Text="{Binding CloudStatusText}"
                                       Style="{StaticResource SmallCaption}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{x:Static helpers:Icons.ChevronRight}"
                                   FontFamily="FASolid" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToAuthCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Other -->
                <Label Text="OTHER"
                       Style="{StaticResource SmallCaption}"
                       FontAttributes="Bold"
                       Margin="20,24,20,8"
                       CharacterSpacing="1" />

                <Border Style="{StaticResource GroupedSection}" Margin="20,0" Padding="0">
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14" ColumnSpacing="12">
                        <Label Text="{x:Static helpers:Icons.RotateRight}"
                               FontFamily="FASolid" FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Redo Onboarding"
                               Style="{StaticResource Body}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="2"
                               Text="{x:Static helpers:Icons.ChevronRight}"
                               FontFamily="FASolid" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                               VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RedoOnboardingCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- App Version -->
                <Label Text="PlateUp v1.0"
                       Style="{StaticResource Caption}"
                       HorizontalOptions="Center"
                       Margin="0,32,0,0" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
