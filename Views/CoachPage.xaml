<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PlateUp.ViewModels"
             xmlns:m="clr-namespace:PlateUp.Models"
             xmlns:helpers="clr-namespace:PlateUp.Helpers"
             xmlns:controls="clr-namespace:PlateUp.Controls"
             x:Class="PlateUp.Views.CoachPage"
             x:DataType="vm:CoachViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="20,12" ColumnSpacing="12"
              BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
            <Border WidthRequest="36" HeightRequest="36"
                    StrokeShape="RoundRectangle 18"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}">
                <Label Text="{x:Static helpers:Icons.Bolt}"
                       FontFamily="FASolid" FontSize="16"
                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="PlateUp Coach"
                       Style="{StaticResource HeadlineSmall}" />
                <Label Text="AI-powered fitness assistant"
                       Style="{StaticResource SmallCaption}" />
            </VerticalStackLayout>
            <Button Grid.Column="2"
                    Text="{x:Static helpers:Icons.Trash}"
                    Style="{StaticResource IconButton}"
                    HeightRequest="36" WidthRequest="36"
                    FontSize="14"
                    Command="{Binding ClearChatCommand}" />
        </Grid>

        <!-- Chat Messages -->
        <CollectionView Grid.Row="1"
                        x:Name="ChatCollectionView"
                        ItemsSource="{Binding Messages}"
                        SelectionMode="None"
                        ItemsUpdatingScrollMode="KeepLastItemInView">

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="12"
                                     Padding="32,60"
                                     HorizontalOptions="Center">
                    <Label Text="{x:Static helpers:Icons.Bolt}"
                           FontFamily="FASolid"
                           FontSize="56"
                           HorizontalOptions="Center"
                           Opacity="0.15"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="Your AI Coach"
                           Style="{StaticResource HeadlineSmall}"
                           HorizontalOptions="Center" />
                    <Label Text="Ask me anything about workouts"
                           Style="{StaticResource Caption}"
                           HorizontalOptions="Center" />

                    <!-- Suggestion chips -->
                    <FlexLayout Wrap="Wrap" JustifyContent="Center"
                                Margin="0,12,0,0"
                                HorizontalOptions="Center">
                        <Border StrokeShape="RoundRectangle 16" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                                Padding="14,8" Margin="4"
                                BackgroundColor="Transparent">
                            <Label Text="Build me a PPL routine"
                                   Style="{StaticResource Caption}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SendSuggestionCommand}"
                                    CommandParameter="Build me a Push Pull Legs routine for intermediate lifters" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border StrokeShape="RoundRectangle 16" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                                Padding="14,8" Margin="4"
                                BackgroundColor="Transparent">
                            <Label Text="How to improve bench press?"
                                   Style="{StaticResource Caption}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SendSuggestionCommand}"
                                    CommandParameter="How can I improve my bench press? Give me tips and accessory exercises" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border StrokeShape="RoundRectangle 16" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                                Padding="14,8" Margin="4"
                                BackgroundColor="Transparent">
                            <Label Text="Analyze my progress"
                                   Style="{StaticResource Caption}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SendSuggestionCommand}"
                                    CommandParameter="Analyze my recent workout history and give me feedback on my progress" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border StrokeShape="RoundRectangle 16" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                                Padding="14,8" Margin="4"
                                BackgroundColor="Transparent">
                            <Label Text="Nutrition tips for gains"
                                   Style="{StaticResource Caption}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SendSuggestionCommand}"
                                    CommandParameter="Give me nutrition tips for muscle gain. What should I eat?" />
                            </Border.GestureRecognizers>
                        </Border>
                    </FlexLayout>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:ChatMessage">
                    <Grid Padding="16,4">
                        <!-- Assistant message (left) -->
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="8"
                              HorizontalOptions="Start"
                              MaximumWidthRequest="320"
                              IsVisible="False">
                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid"
                                             Binding="{Binding Role}"
                                             Value="assistant">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </Grid.Triggers>
                            <Border Grid.Column="0"
                                    WidthRequest="28" HeightRequest="28"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                    VerticalOptions="End">
                                <Label Text="{x:Static helpers:Icons.Bolt}"
                                       FontFamily="FASolid" FontSize="12"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </Border>
                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 18,18,18,4"
                                    StrokeThickness="0"
                                    Padding="14,10"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray850}}">
                                <Label Text="{Binding Content}"
                                       Style="{StaticResource Body}"
                                       FontSize="15"
                                       LineBreakMode="WordWrap" />
                            </Border>
                        </Grid>

                        <!-- User message (right) -->
                        <Border StrokeShape="RoundRectangle 18,18,4,18"
                                StrokeThickness="0"
                                Padding="14,10"
                                HorizontalOptions="End"
                                MaximumWidthRequest="320"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                IsVisible="False">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding Role}"
                                             Value="user">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{Binding Content}"
                                   FontSize="15"
                                   TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                                   LineBreakMode="WordWrap" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <!-- Typing indicator -->
                <HorizontalStackLayout Spacing="8" Padding="16,4" IsVisible="{Binding IsTyping}">
                    <Border WidthRequest="28" HeightRequest="28"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                            VerticalOptions="End">
                        <Label Text="{x:Static helpers:Icons.Bolt}"
                               FontFamily="FASolid" FontSize="12"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </Border>
                    <Border StrokeShape="RoundRectangle 18,18,18,4"
                            StrokeThickness="0"
                            Padding="16,10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray850}}">
                        <Label Text="Typing..."
                               Style="{StaticResource Caption}" />
                    </Border>
                </HorizontalStackLayout>
            </CollectionView.Footer>
        </CollectionView>

        <!-- Input Bar -->
        <Border Grid.Row="2"
                StrokeThickness="0"
                Padding="16,8,16,16"
                BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Border StrokeShape="RoundRectangle 22"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                        Padding="16,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}">
                    <Entry Text="{Binding InputText}"
                           Placeholder="Message Coach..."
                           FontSize="16"
                           BackgroundColor="Transparent"
                           MinimumHeightRequest="44"
                           ReturnType="Send"
                           ReturnCommand="{Binding SendMessageCommand}" />
                </Border>
                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="0"
                        CornerRadius="22"
                        Command="{Binding SendMessageCommand}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FASolid"
                                         Glyph="{x:Static helpers:Icons.ArrowUp}"
                                         Size="18"
                                         Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Border>

        <controls:MiniWorkoutBar Grid.Row="3" />
    </Grid>

</ContentPage>
