<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PlateUp.ViewModels"
             xmlns:dm="clr-namespace:PlateUp.ViewModels.DisplayModels"
             xmlns:helpers="clr-namespace:PlateUp.Helpers"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="PlateUp.Views.ExerciseDetailPage"
             x:DataType="vm:ExerciseDetailViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              Padding="20,12">
            <Button Grid.Column="0"
                    Text="{x:Static helpers:Icons.ChevronLeft}"
                    Style="{StaticResource IconButton}"
                    Command="{Binding GoBackCommand}" />
            <VerticalStackLayout Grid.Column="1"
                                 VerticalOptions="Center"
                                 Margin="8,0,0,0">
                <Label Text="{Binding ExerciseName}"
                       Style="{StaticResource Title}" />
                <Label Text="{Binding MuscleGroupName}"
                       Style="{StaticResource Caption}"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Body -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="20,0,20,24">

                <!-- Records -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="{x:Static helpers:Icons.Trophy}"
                                   FontFamily="FASolid"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource AccentGold}" />
                            <Label Text="Best 1RM"
                                   Style="{StaticResource SmallCaption}"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding Best1RM}"
                                   Style="{StaticResource Body}"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="{x:Static helpers:Icons.Dumbbell}"
                                   FontFamily="FASolid"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource AccentBlue}" />
                            <Label Text="Max Weight"
                                   Style="{StaticResource SmallCaption}"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding BestWeight}"
                                   Style="{StaticResource Body}"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="{x:Static helpers:Icons.Fire}"
                                   FontFamily="FASolid"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource DangerRed}" />
                            <Label Text="Best Volume"
                                   Style="{StaticResource SmallCaption}"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding BestVolume}"
                                   Style="{StaticResource Body}"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Chart Section -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Progress"
                           Style="{StaticResource Title}" />

                    <!-- Period Chips -->
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="1M"
                                Style="{StaticResource SecondaryButton}"
                                HeightRequest="32" MinimumWidthRequest="48"
                                FontSize="12" Padding="8,0"
                                Command="{Binding ChangePeriodCommand}"
                                CommandParameter="1M" />
                        <Button Text="3M"
                                Style="{StaticResource SecondaryButton}"
                                HeightRequest="32" MinimumWidthRequest="48"
                                FontSize="12" Padding="8,0"
                                Command="{Binding ChangePeriodCommand}"
                                CommandParameter="3M" />
                        <Button Text="6M"
                                Style="{StaticResource SecondaryButton}"
                                HeightRequest="32" MinimumWidthRequest="48"
                                FontSize="12" Padding="8,0"
                                Command="{Binding ChangePeriodCommand}"
                                CommandParameter="6M" />
                        <Button Text="1Y"
                                Style="{StaticResource SecondaryButton}"
                                HeightRequest="32" MinimumWidthRequest="48"
                                FontSize="12" Padding="8,0"
                                Command="{Binding ChangePeriodCommand}"
                                CommandParameter="1Y" />
                        <Button Text="All"
                                Style="{StaticResource SecondaryButton}"
                                HeightRequest="32" MinimumWidthRequest="48"
                                FontSize="12" Padding="8,0"
                                Command="{Binding ChangePeriodCommand}"
                                CommandParameter="All" />
                    </HorizontalStackLayout>

                    <lvc:CartesianChart HeightRequest="200"
                                        Series="{Binding ChartSeries}"
                                        XAxes="{Binding XAxes}"
                                        YAxes="{Binding YAxes}" />
                </VerticalStackLayout>

                <!-- History Section -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="History"
                           Style="{StaticResource Title}" />

                    <VerticalStackLayout Spacing="0"
                                         BindableLayout.ItemsSource="{Binding History}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dm:ExerciseHistoryEntry">
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      Padding="0,8"
                                      ColumnSpacing="12">
                                    <Label Grid.Column="0"
                                           Text="{Binding Date, StringFormat='{0:MMM dd}'}"
                                           Style="{StaticResource Caption}"
                                           WidthRequest="60"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding SetsDescription}"
                                           Style="{StaticResource Body}"
                                           VerticalOptions="Center"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="2"
                                           Text="{Binding Estimated1RM, StringFormat='{0:0.#} 1RM'}"
                                           Style="{StaticResource Caption}"
                                           TextColor="{StaticResource AccentBlue}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
