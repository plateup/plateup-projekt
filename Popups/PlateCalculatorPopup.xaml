<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PlateUp.ViewModels"
             xmlns:dm="clr-namespace:PlateUp.ViewModels.DisplayModels"
             x:Class="PlateUp.Popups.PlateCalculatorPopup"
             x:DataType="vm:PlateCalculatorViewModel">

    <Border StrokeShape="RoundRectangle 16"
            StrokeThickness="0"
            Padding="24"
            WidthRequest="350"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}">
        <Border.Shadow>
            <Shadow Brush="{StaticResource BlackBrush}"
                    Offset="0,4"
                    Radius="16"
                    Opacity="0.3" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="16">

            <!-- Title -->
            <Label Text="Plate Calculator"
                   Style="{StaticResource Title}"
                   HorizontalOptions="Center" />

            <!-- Weight Input -->
            <Entry Text="{Binding TotalWeightText}"
                   Style="{StaticResource NumericEntry}"
                   Placeholder="Total weight (kg)"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   HeightRequest="52" />

            <!-- Bar Weight Selection -->
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="Bar:"
                       Style="{StaticResource Caption}"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                <Button Text="10 kg"
                        Style="{StaticResource SecondaryButton}"
                        HeightRequest="32" MinimumWidthRequest="60"
                        FontSize="12" Padding="8,0"
                        Command="{Binding SetBarWeightCommand}"
                        CommandParameter="10" />
                <Button Text="15 kg"
                        Style="{StaticResource SecondaryButton}"
                        HeightRequest="32" MinimumWidthRequest="60"
                        FontSize="12" Padding="8,0"
                        Command="{Binding SetBarWeightCommand}"
                        CommandParameter="15" />
                <Button Text="20 kg"
                        Style="{StaticResource SecondaryButton}"
                        HeightRequest="32" MinimumWidthRequest="60"
                        FontSize="12" Padding="8,0"
                        Command="{Binding SetBarWeightCommand}"
                        CommandParameter="20" />
            </HorizontalStackLayout>

            <!-- Barbell Visualization -->
            <Grid HeightRequest="100"
                  IsVisible="{Binding IsValid}"
                  HorizontalOptions="Center">
                <HorizontalStackLayout Spacing="1"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center"
                                       BindableLayout.ItemsSource="{Binding Plates}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dm:PlateDisplay">
                            <BoxView WidthRequest="{Binding DisplayWidth}"
                                     HeightRequest="{Binding DisplayHeight}"
                                     Color="{Binding Color}"
                                     CornerRadius="3"
                                     VerticalOptions="Center" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>

                <!-- Bar center -->
                <BoxView WidthRequest="80"
                         HeightRequest="8"
                         Color="#757575"
                         CornerRadius="2"
                         VerticalOptions="Center"
                         HorizontalOptions="Center" />
            </Grid>

            <!-- Result Text -->
            <Label Text="{Binding ResultText}"
                   Style="{StaticResource Body}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <!-- Done Button -->
            <Button Text="Done"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnDoneClicked" />

        </VerticalStackLayout>
    </Border>

</ContentView>
