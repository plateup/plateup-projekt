<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PlateUp"
             xmlns:converters="clr-namespace:PlateUp.Converters"
             x:Class="PlateUp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"
                UseThemed="True"
                ThemedTrueColorLightKey="SetCompletedBackgroundLight"
                ThemedTrueColorDarkKey="SetCompletedBackgroundDark" />
            <converters:BoolToColorConverter x:Key="CheckBoolToGreenConverter"
                UseThemed="True"
                ThemedTrueColorLightKey="SuccessGreenLight"
                ThemedTrueColorDarkKey="SuccessGreenDark" />
            <converters:SetTypeToColorConverter x:Key="SetTypeToColorConverter" />
            <converters:SetTypeToLabelConverter x:Key="SetTypeToLabelConverter" />
            <converters:RelativeTimeConverter x:Key="RelativeTimeConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:MuscleGroupToColorConverter x:Key="MuscleGroupToColorConverter" />
            <converters:DoubleToKgLbsConverter x:Key="DoubleToKgLbsConverter" />
            <converters:MuscleGroupToNameConverter x:Key="MuscleGroupToNameConverter" />
            <converters:PercentToProgressConverter x:Key="PercentToProgressConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
